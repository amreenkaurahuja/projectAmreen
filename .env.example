# Public Supabase values (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only. Add only when a server task requires elevated access.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# App settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Optional: Sentry error tracking. Leave unset to run without it — see
# docs/ENVIRONMENTS.md.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
