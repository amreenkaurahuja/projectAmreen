# Public Supabase values (safe for browser use)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# Server-only. Add only when a server task requires elevated access.
# Never prefix this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# App settings
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ENV=development

# Optional: Sentry error tracking. Prepared but inert until explicitly
# enabled (set the *_ENABLED flags to "true") — see docs/ENVIRONMENTS.md.
SENTRY_DSN=
SENTRY_ENABLED=
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENABLED=

# Optional: AI Platform (Phase 5.4). Server-only — never prefix any of
# these with NEXT_PUBLIC_. See docs/ENVIRONMENTS.md and docs/Architecture.md
# → "AI Platform (Phase 5.4)".
# AI_ENABLED is the platform-level master switch; AI_COACH_ENABLED plus the
# per-audience flags gate the coach feature specifically, independently of
# any future second AI feature.
AI_ENABLED=
AI_PROVIDER=gemini
GEMINI_API_KEY=
AI_COACH_MODEL=
AI_COACH_ENABLED=
AI_LEARNER_ENABLED=
AI_PARENT_ENABLED=
# The Question Explainer's own AI-generation switch (TDS-007 Stage 2),
# layered on AI_ENABLED and the same per-audience flags above — separate
# from NEXT_PUBLIC_QUESTION_EXPLAINER_METRICS_ENABLED below, which gates
# metrics delivery, not AI generation.
AI_QUESTION_EXPLAINER_ENABLED=

# Optional: AI budget guard (approximate — see budget-manager.ts). Defaults
# to £10/month and a placeholder per-token price if unset.
AI_MONTHLY_BUDGET_GBP=
AI_ESTIMATED_GBP_PER_1K_TOKENS=

# Optional: Question Explainer learning-metrics delivery (TDS-008 Stage
# 6.3C). Client-evaluated — deliberately NEXT_PUBLIC_ (see
# metrics-feature-flag.ts) — unlike every AI flag above. Unset or anything
# other than "true" keeps the safe no-op publisher; the real HTTP
# publisher only activates when this is exactly "true".
NEXT_PUBLIC_QUESTION_EXPLAINER_METRICS_ENABLED=
